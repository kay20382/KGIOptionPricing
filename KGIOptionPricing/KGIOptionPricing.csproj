<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Required by the closed-source KGI TradeCom library on .NET 9+. -->
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <ApplicationIcon>VICON.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\tools\NikkeiRlModel\NikkeiRlModel.csproj" />
    <None Update="Strategies\NikkeiRlDirection\models\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Strategies\NikkeiRlDirection\analysis\analyze_main_strategy.py" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="log4net" Version="3.3.2" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Package">
      <HintPath>libs\Package.dll</HintPath>
    </Reference>
    <Reference Include="QuoteCom">
      <HintPath>libs\QuoteCom.dll</HintPath>
    </Reference>
    <Reference Include="TradeCom">
      <HintPath>libs\TradeCom.dll</HintPath>
    </Reference>
    <Reference Include="PushClient">
      <HintPath>libs\PushClient.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="holidays.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Strategies\PowerReversal\profiles\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Strategies\MultiFactorMeanR17\profiles\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Strategies\MultiFactorMeanR17\analysis\*.py" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Strategies\PowerReversal\analysis\analyze_power_reversal.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
